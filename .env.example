# HubSpot private app / service key (server-side only — never commit the real value)
# HubSpot → Settings → Integrations → Private Apps
# Required scopes:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
# Set the same variable in Vercel → Project → Settings → Environment Variables
# for Production (and Preview if you test Free Audit on preview URLs).
HUBSPOT_ACCESS_TOKEN=

# Local site + API port (used by npm run dev / ./serve.sh)
PORT=8082
